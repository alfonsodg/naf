# Environment variables for the naf service (rev).
# Every variable the service needs in this environment. Real values never
# belong in this tracked file: fill them in the gitignored `.env` or the
# deployment environment.

# --- Application ---
# Display name used in logs and the OpenAPI document.
NAF_APP_NAME=naf
# Enables FastAPI debug mode. Never enable in QA or production.
NAF_DEBUG=false
# URL prefix for versioned API routes.
NAF_API_PREFIX=/api/v1
# IANA timezone used to render dates on the web pages. The API always serves UTC.
NAF_DISPLAY_TIMEZONE=UTC

# Logging
# Minimum level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
NAF_LOG_LEVEL=INFO
# Emit JSON logs (true in deployed environments, false for readable local output).
NAF_LOG_JSON=true

# --- Complement database (NAF-owned, separate from Miniflux) ---
# PostgreSQL DSN. Required; startup fails when absent.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
NAF_DATABASE_URL=

# --- Miniflux reader API ---
# Base URL of the Miniflux instance (no trailing slash).
NAF_MINIFLUX_URL=
# API token created in Miniflux (Settings > API Keys). Required.
NAF_MINIFLUX_API_KEY=
# Per-request timeout in seconds.
NAF_MINIFLUX_TIMEOUT=30
# Retry attempts for idempotent reads.
NAF_MINIFLUX_MAX_RETRIES=3

# --- Feed intake and validation ---
# Per-feed HTTP timeout in seconds while validating a candidate feed.
NAF_FEED_VALIDATION_TIMEOUT=15
# Maximum parallel feed probes during one intake (1-32).
NAF_FEED_VALIDATION_CONCURRENCY=8
# Redirect hops followed while validating a feed (0-10).
NAF_FEED_VALIDATION_MAX_REDIRECTS=5
# Maximum parallel feed probes against the same host (1-8).
NAF_FEED_VALIDATION_PER_HOST_CONCURRENCY=2
# Retries after a host asks the client to wait (0-5).
NAF_FEED_VALIDATION_MAX_RETRIES=2
# Base delay in seconds between retries of a refused request.
NAF_FEED_VALIDATION_RETRY_BACKOFF=1.0
# Largest accepted intake payload or feed response body, in bytes.
NAF_FEED_INTAKE_MAX_BYTES=1000000
# Maximum candidates probed in one intake request (1-500).
NAF_FEED_INTAKE_MAX_BATCH=50
# Seconds one intake request may spend probing candidates.
NAF_FEED_INTAKE_TIME_BUDGET=25

# --- LLM adapter (classification and reports) ---
# Provider identifier understood by the LLM adapter.
NAF_LLM_PROVIDER=openai
# Provider API key. Leave empty until the adapter is implemented.
NAF_LLM_API_KEY=
# Model identifier; empty selects the provider default.
NAF_LLM_MODEL=

# OpenAI-compatible API root; the adapter appends /chat/completions.
NAF_LLM_BASE_URL=https://api.openai.com/v1
# Seconds allowed for one completion.
NAF_LLM_TIMEOUT=120
# Hard ceiling on tokens the provider may return for one report.
NAF_LLM_MAX_OUTPUT_TOKENS=6000

# --- Report generation ---
# Largest selection sent to the model; bounds the per-report cost.
NAF_REPORT_MAX_ENTRIES=40
# Window used when a request names neither a period nor since_last.
NAF_REPORT_DEFAULT_DAYS=7

# --- TTS adapter (Spanish audio) ---
# TTS backend identifier (podcastfy or a direct provider).
NAF_TTS_PROVIDER=podcastfy
# Voice identifier; empty selects the provider default Spanish voice.
NAF_TTS_VOICE=
# BCP-47 language tag for synthesis.
NAF_TTS_LANGUAGE=es-ES
# Speech rate multiplier.
NAF_TTS_SPEED=1.0

# --- Audio storage ---
# Filesystem directory for generated audio (dev only).
NAF_AUDIO_STORAGE_PATH=./storage/audio
# Public base URL for served audio; empty means filesystem paths only.
NAF_AUDIO_BASE_URL=

# --- Compose orchestration (deploy/compose/docker-compose.yml) ---
# PostgreSQL role created on first initialization. Consumed by the db service.
NAF_DB_USER=
# PostgreSQL password for that role. Sourced from the secret store.
NAF_DB_PASSWORD=
# Database name created on first initialization.
NAF_DB_NAME=
# Immutable image tag to run (environment-specific). Never "latest".
NAF_IMAGE=
# Host port that publishes the naf API container port 8000.
NAF_PORT=8000
# PostgreSQL role of the reader database. Consumed by the miniflux-db service.
NAF_MINIFLUX_DB_USER=
# PostgreSQL password of the reader database. Sourced from the secret store.
NAF_MINIFLUX_DB_PASSWORD=
# Database name of the reader database.
NAF_MINIFLUX_DB_NAME=
# Administrator of the reader, created on its first start.
NAF_MINIFLUX_ADMIN_USERNAME=
# Password of the reader administrator. Sourced from the secret store.
NAF_MINIFLUX_ADMIN_PASSWORD=
# Host port that publishes the reader port 8080.
NAF_MINIFLUX_PORT=8080
# Browser-facing base URL of the reader. It must be the address a person uses
# (host and published port), not the internal service name.
NAF_MINIFLUX_BASE_URL=http://localhost:8080
# Minutes between RSS/Atom polls. Decision 4 approves 15-30; 20 keeps the 8-30
# source pack inside the promised window.
NAF_MINIFLUX_POLLING_FREQUENCY=20
# Scheduler that hands due feeds to the poller (round_robin or
# entry_frequency). round_robin keeps every source on the approved cadence.
NAF_MINIFLUX_POLLING_SCHEDULER=round_robin
# Feeds refreshed per scheduler pass. 50 covers the 8-30 source pack with
# headroom, so one pass never truncates it.
NAF_MINIFLUX_BATCH_SIZE=50

# Days after an entry is read before the reader archives it. Decision 8
# approves a 30-90 day window; 90 keeps a read entry as long as allowed.
NAF_MINIFLUX_CLEANUP_READ_DAYS=90
# Days an unread entry stays before the reader archives it. 180 keeps it until
# it has had a chance to be read; never set below the read value.
NAF_MINIFLUX_CLEANUP_UNREAD_DAYS=180
# Hours between cleanup runs (24 = once a day). Archiving records a tombstone,
# so a later feed refresh never re-imports the same entry.
NAF_MINIFLUX_CLEANUP_FREQUENCY=24

# Host port that publishes the auth proxy in front of the API. The proxy is
# the only public surface; the API itself stays bound to loopback.
NAF_PROXY_PORT=18082
# Path to the proxy password file (htpasswd), relative to deploy/compose/.
# Deployment-only: it is gitignored here, deployments point it at an absolute
# path outside the checkout, and it is never committed.
NAF_PROXY_HTPASSWD=../proxy/htpasswd
