# Environment variables for the naf service (qa).
# Every variable the service needs in this environment. Real values never
# belong in this tracked file: fill them in the gitignored `.env` or the
# deployment environment.

# --- Application ---
# Display name used in logs and the OpenAPI document.
NAF_APP_NAME=naf
# Enables FastAPI debug mode. Never enable in QA or production.
NAF_DEBUG=false
# URL prefix for versioned API routes.
NAF_API_PREFIX=/api/v1

# Logging
# Minimum level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
NAF_LOG_LEVEL=INFO
# Emit JSON logs (true in deployed environments, false for readable local output).
NAF_LOG_JSON=true

# --- Complement database (NAF-owned, separate from Miniflux) ---
# PostgreSQL DSN. Required; startup fails when absent.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
NAF_DATABASE_URL=

# --- Miniflux reader API ---
# Base URL of the Miniflux instance (no trailing slash).
NAF_MINIFLUX_URL=
# API token created in Miniflux (Settings > API Keys). Required.
NAF_MINIFLUX_API_KEY=
# Per-request timeout in seconds.
NAF_MINIFLUX_TIMEOUT=30
# Retry attempts for idempotent reads.
NAF_MINIFLUX_MAX_RETRIES=3

# --- Feed intake and validation ---
# Per-feed HTTP timeout in seconds while validating a candidate feed.
NAF_FEED_VALIDATION_TIMEOUT=15
# Maximum parallel feed probes during one intake (1-32).
NAF_FEED_VALIDATION_CONCURRENCY=8
# Redirect hops followed while validating a feed (0-10).
NAF_FEED_VALIDATION_MAX_REDIRECTS=5
# Maximum parallel feed probes against the same host (1-8).
NAF_FEED_VALIDATION_PER_HOST_CONCURRENCY=2
# Retries after a host asks the client to wait (0-5).
NAF_FEED_VALIDATION_MAX_RETRIES=2
# Base delay in seconds between retries of a refused request.
NAF_FEED_VALIDATION_RETRY_BACKOFF=1.0
# Largest accepted intake payload or feed response body, in bytes.
NAF_FEED_INTAKE_MAX_BYTES=1000000
# Maximum candidates probed in one intake request (1-500).
NAF_FEED_INTAKE_MAX_BATCH=50
# Seconds one intake request may spend probing candidates.
NAF_FEED_INTAKE_TIME_BUDGET=25

# --- LLM adapter (classification and reports) ---
# Provider identifier understood by the LLM adapter.
NAF_LLM_PROVIDER=openai
# Provider API key. Leave empty until the adapter is implemented.
NAF_LLM_API_KEY=
# Model identifier; empty selects the provider default.
NAF_LLM_MODEL=

# --- TTS adapter (Spanish audio) ---
# TTS backend identifier (podcastfy or a direct provider).
NAF_TTS_PROVIDER=podcastfy
# Voice identifier; empty selects the provider default Spanish voice.
NAF_TTS_VOICE=
# BCP-47 language tag for synthesis.
NAF_TTS_LANGUAGE=es-ES
# Speech rate multiplier.
NAF_TTS_SPEED=1.0

# --- Audio storage ---
# Filesystem directory for generated audio (dev only).
NAF_AUDIO_STORAGE_PATH=./storage/audio
# Public base URL for served audio; empty means filesystem paths only.
NAF_AUDIO_BASE_URL=

# --- Compose orchestration (deploy/compose/docker-compose.yml) ---
# PostgreSQL role created on first initialization. Consumed by the db service.
NAF_DB_USER=
# PostgreSQL password for that role. Sourced from the secret store.
NAF_DB_PASSWORD=
# Database name created on first initialization.
NAF_DB_NAME=
# Immutable image tag to run (environment-specific). Never "latest".
NAF_IMAGE=
# Host port that publishes the naf API container port 8000.
NAF_PORT=8000
