# NAF configuration example - copy to .env and fill in
# Never commit .env with real secrets

# App
NAF_DEBUG=false

# Database (complement DB)
NAF_DATABASE_URL=postgresql://user:password@localhost:5432/naf

# Miniflux API
NAF_MINIFLUX_URL=http://localhost:8080
NAF_MINIFLUX_API_KEY=

# LLM
NAF_LLM_PROVIDER=openai
NAF_LLM_API_KEY=
NAF_LLM_MODEL=gpt-4o-mini

# TTS
NAF_TTS_PROVIDER=podcastfy
NAF_TTS_LANGUAGE=es-ES

# Audio storage
NAF_AUDIO_STORAGE_PATH=./storage/audio
NAF_AUDIO_BASE_URL=
